# Copy this to .env.local and fill in the service-role key from
# https://supabase.com/dashboard/project/uoxycinbtvjfihakkuft/settings/api
# The service role key is server-only — never commit it.

NEXT_PUBLIC_SUPABASE_URL=https://uoxycinbtvjfihakkuft.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Quick Add secret. The /new-defect page and the "+ Log defect" button only
# work when the URL includes ?key=<this value>. Use a long random string
# (32+ chars), same value locally and in Vercel. Rotate if it ever leaks.
# Generate one with:  openssl rand -hex 24
QUICK_ADD_SECRET=
