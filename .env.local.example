# Copy this to .env.local and fill in the service-role key from
# https://supabase.com/dashboard/project/uoxycinbtvjfihakkuft/settings/api
# The service role key is server-only — never commit it.

NEXT_PUBLIC_SUPABASE_URL=https://uoxycinbtvjfihakkuft.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Quick Add secret. The /new-defect page and the "+ Log defect" button only
# work when the URL includes ?key=<this value>. Use a long random string
# (32+ chars), same value locally and in Vercel. Rotate if it ever leaks.
# Generate one with:  openssl rand -hex 24
QUICK_ADD_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — see docs/whatsapp-setup.md for setup steps.
# Leave these blank until Meta Business Verification completes and the app is
# set up. The dispatch UI is still visible without them but sends will error.
# ---------------------------------------------------------------------------

# From: developers.facebook.com → your app → WhatsApp → API Setup → Phone number
WHATSAPP_PHONE_NUMBER_ID=

# System User access token (permanent). Never rotates unless you regenerate.
# Never commit. Store in Vercel env vars only.
WHATSAPP_ACCESS_TOKEN=

# Verify token — a string YOU choose, then paste into Meta's Webhook config.
# Generate a random one:  openssl rand -hex 16
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App secret — from developers.facebook.com → your app → Settings → Basic.
# Used to verify inbound webhook signatures.
WHATSAPP_APP_SECRET=
